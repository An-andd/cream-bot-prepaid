# ---------- WhatsApp Cloud API (Meta developers test number) ----------
WHATSAPP_TOKEN=EAAG...your-permanent-or-temp-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=cream-verify
WHATSAPP_API_VERSION=v22.0
# Only these numbers may use the bot (country code + number, no +)
ALLOWED_SENDERS=918129770502

# ---------- Sender block printed on every label ----------
SENDER_NAME=CREAM X EMIRATES
SENDER_ADDRESS=PUTHUPALLY, KTM
SENDER_PIN=686011
SENDER_PHONE=8129770502

# ---------- Biller IDs offered as option1 / option2 / option3 ----------
BILLERS={"option1":{"label":"default","id":"1260357626"},"option2":{"label":"alternative 1","id":"1264602129"},"option3":{"label":"alternative 2","id":"1624036027"}}

# ---------- Label layout (defaults match the current printed labels) ----------
PAGE_SIZE=A4
LABELS_PER_ROW=2
LABEL_ROWS=3
PAGE_MARGIN_MM=8
LABEL_PADDING_MM=5
BASE_FONT_SIZE=10
MIN_FONT_SIZE=6
FONT_NAME=Helvetica
FONT_NAME_BOLD=Helvetica-Bold
PHONE_LABEL=Phone Number
DRAW_BORDER=true
FROM_BLOCK_POSITION=right   # right (like the printed labels) | below
TO_COLUMN_RATIO=0.58        # share of the label width given to the To: block
FROM_VALIGN=bottom          # bottom | middle | top
COLUMN_GAP_MM=3
OUTPUT_FORMAT=pdf          # pdf | docx | both
# DOCX_TEMPLATE=template.docx

# ---------- Products ----------
KNOWN_PRODUCTS=cxe
NOTE_WORDS=return,forgot,mistake,dtdc,urgent,replacement,exchange,repeat,free,gift,cancel,resend

# ---------- WooCommerce (optional, for the `woo` command) ----------
WOO_URL=https://yourstore.com
WOO_CONSUMER_KEY=ck_xxx
WOO_CONSUMER_SECRET=cs_xxx
WOO_PAID_STATUSES=processing,completed
WOO_COD_METHODS=cod,cash on delivery

# ---------- Storage ----------
DB_PATH=/tmp/cream_prepaid.sqlite3
OUTPUT_DIR=/tmp/cream_labels
